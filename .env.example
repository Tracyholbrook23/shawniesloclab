# Copy this to .env.local for local development, and add the same names
# (with real values) to the Vercel project's Environment Variables for
# Preview/Production. Never commit real keys — only this template.

# --- Stripe -----------------------------------------------------------
# From the Stripe Dashboard (Developers -> API keys). Use the sk_test_/
# pk_test_ pair while building; swap to sk_live_/pk_live_ only once
# Shawnie's Stripe account is fully verified and ready for real payments.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# From Stripe Dashboard -> Developers -> Webhooks, after adding an
# endpoint pointed at https://<your-domain>/api/stripe-webhook,
# subscribed to the "checkout.session.completed" event.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Redis (live goal-tracker total + supporter wall) ------------------
# Vercel's own "KV" product was retired — add a Redis integration from
# the Vercel dashboard instead: Storage tab -> Marketplace Database
# Providers -> search "Redis" (Upstash is the usual pick). Vercel
# injects these two automatically once it's connected to this project,
# so you likely won't type them by hand except for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Fundraiser settings ------------------------------------------------
# The goal amount, in whole cents (no decimal). $12,000 shown here is a
# placeholder — update it once Shawnie has a real tuition + kit +
# state-board-exam total.
SUPPORT_GOAL_CENTS=1200000
